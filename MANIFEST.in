# Source-distribution contents — used only by `python -m build` / sdist.
# Editable installs (`pip install -e .`) ignore this file entirely; it shapes
# the distributable tarball, nothing else.
#
# The cusadi package .py files and pyproject.toml are auto-included by
# setuptools; this file adds the non-Python *sources* needed to build from a
# clean tarball, and prunes everything regenerable or artifact-like.

# --- Top-level docs / license ---
include README.md
include ALGORITHM.md
include LICENSE.txt

# --- Hand-authored native sources required to compile extensions ---
# The JAX-FFI C++ backend must ship so the extension can build from source.
# (Add `include cusadi/jax_ffi/*.h` here if headers are introduced later.)
include cusadi/jax_ffi/*.cpp
# Docs that live beside the hand-authored kernel templates.
include cusadi/lp_kernels/README.md

# --- Exclude regenerable / generated / artifact files ---
# Level-parallel .cu kernels are intentionally NOT shipped: they are
# materialized at build time from cusadi/level_parallel/codegen.py.
recursive-exclude cusadi/lp_kernels *.cu

# Build trees, research experiments, and tests are not part of the library.
prune build
prune experiments
prune tests
prune .claude

# Generated CasADi/codegen artifacts and compiled objects, wherever they sit.
global-exclude *.so *.o *.a
global-exclude *.casadi *.mat *.c *_PT.py
global-exclude CMakeLists.txt
global-exclude *.py[cod]
global-exclude __pycache__
